{
  "name": "@morsewayne/dsh-agy-acp",
  "version": "0.6.0",
  "description": "Next-generation Google Antigravity (agy acp) bridge plugin for DeepSeek Harness — persistent ACP JSON-RPC sessions, interactive permission callbacks, native tool mirroring, and SSE status stream.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MorseWayne/dsh-agy-acp.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "antigravity",
    "agy",
    "acp"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@types/node": "^24.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsdown",
    "check": "tsc --noEmit",
    "lint:arch": "node scripts/lint-arch.mjs",
    "test": "node --experimental-transform-types --test \"test/**/*.test.ts\"",
    "verify": "pnpm run lint:arch && pnpm run check && pnpm run build && pnpm test"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
